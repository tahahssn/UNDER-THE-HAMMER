# Names and descriptions only. Never commit real values.

# --- Runtime ---
NODE_ENV=development
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database (PostgreSQL / Neon) ---
# Pooled connection used by the API at runtime
DATABASE_URL=
# Direct (non-pooled) connection used by Prisma migrations
DIRECT_URL=

# --- Redis (Socket.IO adapter, rate limiting) ---
REDIS_URL=

# --- AWS Cognito (Phase C) ---
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- AWS S3 (Phase E) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
S3_PRESIGNED_EXPIRY=3600
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png

# --- Payments (Phase L) ---
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
